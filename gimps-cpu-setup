#!/usr/bin/env bash
# Первичная настройка mprime (Prime95 для Linux) для расчётов на CPU параллельно с GPU.
# Вызывается из gimps-start автоматически; вручную: gimps-cpu-setup [--force]
# Переменные: GIMPS_USER, GIMPS_NAME, CPU_WORKPREF (по умолч. 4 = P-1), CPU_CORES (auto), CPU_WORKERS (по умолч. 2, при < 4 ядрах — 1),
#             CPU_MEM_GB (auto), DATA_DIR
set -uo pipefail
DATA_DIR="${DATA_DIR:-/data}"
for f in "$DATA_DIR/.onstart.env" "$DATA_DIR/gimps.env"; do [ -f "$f" ] && set -a && . "$f" && set +a; done
D="$DATA_DIR/cpu"; mkdir -p "$D"; cd "$D" || exit 1
for f in /opt/gimps/mprime/*; do [ -e "$f" ] && { [ -e "$(basename "$f")" ] || ln -s "$f" .; }; done


# сколько CPU выделено контейнеру (cgroup v2 / v1), иначе — nproc
alloc="$(nproc)"; quota=0
if [ -r /sys/fs/cgroup/cpu.max ]; then
  read -r q p < /sys/fs/cgroup/cpu.max; [ "$q" != "max" ] && { alloc=$(( q / p )); quota=1; }   # 46.08 CPU → 46: не превышаем квоту
elif [ -r /sys/fs/cgroup/cpu/cpu.cfs_quota_us ]; then
  q=$(cat /sys/fs/cgroup/cpu/cpu.cfs_quota_us); p=$(cat /sys/fs/cgroup/cpu/cpu.cfs_period_us)
  [ "$q" -gt 0 ] && { alloc=$(( q / p )); quota=1; }
fi
[ "$alloc" -lt 1 ] && alloc=1; [ "$alloc" -gt "$(nproc)" ] && alloc="$(nproc)"
tpc="$(lscpu 2>/dev/null | awk -F: '/Thread\(s\) per core/ {gsub(/ /,"",$2); print $2}')"; tpc="${tpc:-1}"
# Квота cgroup — это время логических CPU: 19.2 из 80 потоков хоста почти всегда раскладываются по разным
# физическим ядрам, поэтому делить её на потоки-на-ядро нельзя (иначе mprime займёт лишь половину квоты).
# Без квоты (весь сервер наш) — берём физические ядра: для FFT гипертрединг почти ничего не даёт.
if [ "$quota" = 1 ] && [ "$alloc" -lt "$(nproc)" ]; then phys=$alloc; else phys=$(( alloc / tpc )); fi
[ "$phys" -lt 1 ] && phys=1
# по одному ядру оставляем каждому GPU-воркеру (PRPLL/mfaktc держат по потоку на карту)
if [ -n "${GIMPS_GPUS:-}" ]; then ngpu=$(tr ',' '\n' <<<"$GIMPS_GPUS" | grep -c .)
else ngpu=$(nvidia-smi -L 2>/dev/null | grep -c '^GPU'); fi
[ "${ngpu:-0}" -lt 1 ] && ngpu=1
CORES="${CPU_CORES:-$(( phys > ngpu ? phys - ngpu : 1 ))}"

# воркеры: по умолчанию 2 (если ядер ≥ 4), ядра делятся поровну, память stage 2 mprime делит между ними сам.
# Замер на EPYC 9474F (46 ядер, P-1 ~162M): 1×45 — 2,5 %/мин stage 1, 2×22 — 2,35–2,8 %/мин; два воркера
# закрывают задания парами и не простаивают, пока один из них в однопоточных фазах (GCD, переход к stage 2).
# CPU_WORKERS=N — вручную; тип работы прописывается каждому воркеру.
WORKERS="${CPU_WORKERS:-$(( CORES >= 4 ? 2 : 1 ))}"; [ "$WORKERS" -lt 1 ] && WORKERS=1
PER=$(( CORES / WORKERS )); [ "$PER" -lt 1 ] && PER=1

# память: половина лимита контейнера (или RAM), но не больше 64 ГиБ на воркер
mem_kb="$(awk '/MemTotal/ {print $2}' /proc/meminfo)"
if [ -r /sys/fs/cgroup/memory.max ] && [ "$(cat /sys/fs/cgroup/memory.max)" != "max" ]; then
  mem_kb=$(( $(cat /sys/fs/cgroup/memory.max) / 1024 ))
fi
# авто: половина памяти контейнера, но не больше 64 ГиБ на воркер (больше P-1 stage 2 обычно не окупает);
# mprime делит Memory между воркерами, которые одновременно в stage 2. Явный CPU_MEM_GB потолком не ограничен
if [ -n "${CPU_MEM_GB:-}" ]; then MEM="$CPU_MEM_GB"
else MEM=$(( mem_kb / 1024 / 1024 / 2 )); [ "$MEM" -gt $(( 64 * WORKERS )) ] && MEM=$(( 64 * WORKERS )); fi
[ "$MEM" -lt 1 ] && MEM=1

# Ядра и память — свойства КОНКРЕТНОЙ машины, а папка cpu/ переезжает между машинами через бэкап. Поэтому при
# каждом старте задаём их заново. mprime 30.x хранит их в prime.txt (раньше — в local.txt); правим оба, если есть.
enforce_cores() {
  local f k v w mem_mb=$(( MEM * 1024 )) type="${CPU_WORKPREF:-4}"
  for f in prime.txt local.txt; do
    [ -f "$f" ] || continue
    for kv in "NumWorkers=$WORKERS" "CoresPerTest=$PER"; do
      k="${kv%%=*}"; v="${kv#*=}"
      if grep -q "^$k=" "$f"; then sed -i "s/^$k=.*/$k=$v/" "$f"; elif [ "$f" = prime.txt ]; then sed -i "1i $k=$v" "$f"; fi
    done
    grep -q '^Memory=' "$f" && sed -i "s/^Memory=.*/Memory=$mem_mb during 7:30-23:30 else $mem_mb/" "$f"
  done
  # чекпойнт mprime раз в 10 мин (по умолчанию 30): облачные хосты иногда перезапускают контейнер без
  # предупреждения, и всё посчитанное после последнего сохранения теряется
  if [ -f prime.txt ]; then
    if grep -q '^DiskWriteTime=' prime.txt; then sed -i "s/^DiskWriteTime=.*/DiskWriteTime=${CPU_SAVE_MIN:-10}/" prime.txt
    else sed -i "1i DiskWriteTime=${CPU_SAVE_MIN:-10}" prime.txt; fi
  fi
  # stage 2 сразу у всех воркеров: по умолчанию mprime пускает в «тяжёлую по памяти» фазу ограниченное число
  # воркеров, остальные откладывают stage 2 и начинают stage 1 следующего задания
  # («Exceeded limit on number of workers that can use lots of memory»)
  if [ -f prime.txt ]; then
    if grep -q '^MaxHighMemWorkers=' prime.txt; then sed -i "s/^MaxHighMemWorkers=.*/MaxHighMemWorkers=$WORKERS/" prime.txt
    else sed -i "1i MaxHighMemWorkers=$WORKERS" prime.txt; fi
  fi
  # тип работы — каждому воркеру явно (иначе новый воркер получает от сервера что угодно: PRP, double-check…)
  [ -f prime.txt ] || return 0
  sed -i "s/^WorkPreference=.*/WorkPreference=$type/" prime.txt
  grep -q '^WorkPreference=' prime.txt || sed -i "1i WorkPreference=$type" prime.txt
  for w in $(seq 1 "$WORKERS"); do
    if grep -q "^\[Worker #$w\]" prime.txt; then
      awk -v w="[Worker #$w]" -v t="$type" '
        $0==w {print; print "WorkPreference=" t; f=1; next}
        /^\[/ {f=0} f && /^WorkPreference=/ {next} {print}' prime.txt > prime.txt.new && mv prime.txt.new prime.txt
    else
      printf '\n[Worker #%s]\nWorkPreference=%s\n' "$w" "$type" >> prime.txt
    fi
  done
}

# Сохранения mprime для экспонент, которых нет в очереди (задание возвращено/завершено), больше не нужны,
# а PRP-остатки для proof весят гигабайты (p<exp>.residues) и раздувают бэкап. mprime в этот момент не запущен.
clean_orphans() {
  [ -s worktodo.txt ] || return 0
  local f e n=0
  for f in [pmefc][0-9]*; do
    [ -f "$f" ] || continue
    e="${f:1}"; e="${e%%.*}"
    [[ "$e" =~ ^[0-9]+$ ]] || continue
    grep -qE "(^|[=,])$e(,|$)" worktodo.txt && continue
    rm -f -- "$f"; n=$((n + 1))
  done
  [ $n -gt 0 ] && echo "mprime: удалено старых файлов сохранения (экспонент нет в очереди): $n"
}
clean_orphans

# Подстраховка: если у какого-то воркера нет P-1 (новый воркер, восстановление из бэкапа другой машины), отдаём
# ему часть очереди P-1 соседа, пока mprime не запущен, — иначе он сам запросит работу и может получить не P-1.
rebalance() {
  [ "$WORKERS" -ge 2 ] && [ -s worktodo.txt ] || return 0
  python3 - "$WORKERS" <<'PY'
import re, sys
n = int(sys.argv[1]); p = "worktodo.txt"
sec, cur = {}, 1
for line in open(p).read().split("\n"):
    m = re.match(r"\[Worker #(\d+)\]", line.strip())
    if m: cur = int(m[1]); sec.setdefault(cur, []); continue
    if line.strip(): sec.setdefault(cur, []).append(line)
for w in range(1, n + 1): sec.setdefault(w, [])
pf = lambda w: [l for l in sec[w] if l.startswith("Pfactor=")]
moved = 0
# задания не-P-1 (PRP, double-check — достались от старых настроек) переносим в конец очереди своего воркера:
# P-1 на CPU даёт в разы больше работы за то же время, а начатый PRP не теряется — он досчитается позже
for w in sec:
    pfl = [l for l in sec[w] if l.startswith("Pfactor=")]
    if pfl and sec[w] and not sec[w][0].startswith("Pfactor="):
        sec[w] = pfl + [l for l in sec[w] if not l.startswith("Pfactor=")]; moved += 1
for w in range(1, n + 1):
    if pf(w): continue
    donor = max(sec, key=lambda d: len(pf(d)))
    give = pf(donor)[1:][len(pf(donor)[1:]) // 2:]          # первую (начатую) задачу донора не трогаем
    if not give: continue
    for l in give: sec[donor].remove(l)
    sec[w] = give + sec[w]; moved += len(give)
if moved:
    out = []
    for w in sorted(sec):
        out += [f"[Worker #{w}]"] + sec[w] + [""]
    open(p, "w").write("\n".join(out))
    print(f"mprime: очередь перестроена (P-1 — первыми у каждого воркера), изменений: {moved}")
PY
}

if [ "${1:-}" != "--force" ] && grep -qs '^V5UserID=' prime.txt; then
  enforce_cores; rebalance
  echo "mprime уже настроен ($D/prime.txt); для этой машины: воркеров $WORKERS × $PER ядер, память stage 2 $MEM ГиБ. Перенастроить: gimps-cpu-setup --force"; exit 0
fi

USERID="${GIMPS_USER:-ANONYMOUS}"
NAME="${GIMPS_NAME:-cloud}-cpu"
TYPE="${CPU_WORKPREF:-4}"
echo "mprime: пользователь=$USERID, компьютер=$NAME, тип работы=$TYPE, ядер=$CORES (выделено CPU: $alloc), память stage 2=$MEM ГиБ"
[ "${1:-}" = "--force" ] && rm -f prime.txt local.txt
timeout 900 expect /opt/gimps/share/mprime-setup.exp "$USERID" "$NAME" "$TYPE" "$PER" "$MEM" "$WORKERS" > setup.log 2>&1
rc=$?
if grep -qs '^V5UserID=' prime.txt; then
  enforce_cores; rebalance
  echo "mprime настроен (лог: $D/setup.log), воркеров: $WORKERS × $PER ядер"; exit 0
fi
echo "mprime: автонастройка не удалась (rc=$rc), см. $D/setup.log. Можно настроить вручную: cd $D && ./mprime -m"
exit 1
